# Model provider: mock or openai_compatible
MODEL_PROVIDER=mock
MODEL_PROXY_MODE=system
# system: follow computer proxies; direct: no proxy; custom: use MODEL_PROXY_URL.
# HTTP(S), socks5:// or socks5h://; never share a proxy URL containing credentials.
MODEL_PROXY_URL=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Model request and context limits
MODEL_TIMEOUT_SECONDS=60
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=256
CONTEXT_MAX_MESSAGES=12
MODEL_MAX_OUTPUT_CHARS=1200
SYSTEM_PROMPT_PATH=app/prompts/chat.txt
REPLY_REPAIR_PROMPT_PATH=app/prompts/reply_repair.txt

# Local application settings
CHATBOT_DATABASE_PATH=data/chatbot.db
CHATBOT_LOG_PATH=data/chatbot.log
MESSAGE_DEBOUNCE_SECONDS=1.2

# Batched long-term memory maintenance (no extra call before the threshold)
MEMORY_AUTO_PROCESS_ENABLED=true
MEMORY_EXTRACTION_INTERVAL_MESSAGES=12
SUMMARY_TRIGGER_MESSAGES=24
MEMORY_PROCESSING_BATCH_MESSAGES=40
MEMORY_FAILURE_RETRY_SECONDS=300
MEMORY_CONFIDENCE_THRESHOLD=0.85
MEMORY_CONTEXT_LIMIT=6
MEMORY_CONTEXT_FALLBACK=2
MEMORY_DEBUG=false
MEMORY_PROMPT_PATH=app/prompts/memory_maintenance.txt

# NapCat / OneBot QQ
QQ_ENABLED=false
QQ_WEBUI_URL=http://127.0.0.1:6099/webui/
# NapCat WebUI login token; separate from QQ_WS_TOKEN.
# Leave blank to auto-read a local NapCat config/webui.json.
QQ_WEBUI_TOKEN=
QQ_WEBUI_CONFIG_PATH=
QQ_WS_URL=ws://127.0.0.1:3001
# OneBot WebSocket Bearer token, not the WebUI login token; settings masks both.
QQ_WS_TOKEN=
QQ_PRIMARY_CONTACT_ID=
QQ_PRIMARY_CONTACT_NAME=宇飞
QQ_ADMIN_CONTACT_IDS=
QQ_ADMIN_MEMORY_PREFIX=#指令
QQ_ADMIN_CONFIG_PREFIX=#配置
QQ_TRAINING_GROUP_IDS=
QQ_REPLY_GROUP_IDS=
QQ_DRY_RUN=true
QQ_AUTO_REPLY_ENABLED=true

# Empty contact allowlist means recently active private contacts.
QQ_PROACTIVE_ENABLED=false
QQ_PROACTIVE_CONTACT_IDS=
QQ_PROACTIVE_EXCLUDE_CONTACT_IDS=
QQ_PROACTIVE_MIN_SECONDS=1800
QQ_PROACTIVE_MAX_SECONDS=3600
QQ_PROACTIVE_DAILY_LIMIT=0
QQ_PROACTIVE_RECENT_DAYS=7
QQ_PROACTIVE_QUIET_START=23:59
QQ_PROACTIVE_QUIET_END=07:00
PROACTIVE_PROMPT_PATH=app/prompts/proactive.txt

QQ_FOLLOWUP_ENABLED=true
QQ_FOLLOWUP_PROBABILITY=0.15
QQ_FOLLOWUP_MIN_DELAY_SECONDS=2
QQ_FOLLOWUP_MAX_DELAY_SECONDS=7
FOLLOWUP_PROMPT_PATH=app/prompts/followup.txt

QQ_IMAGE_MAX_BYTES=8388608
QQ_IMAGE_TIMEOUT_SECONDS=10
QQ_IMAGE_ALLOW_REMOTE_URL=true
QQ_IMAGE_HISTORY_LIMIT=1

# Local human style-sample collection and redacted export
STYLE_CONTEXT_MIN_MESSAGES=3
STYLE_CONTEXT_MAX_MESSAGES=10
STYLE_EXPORT_PATH=data/style_samples.jsonl

# Desktop presentation only; does not change what the model can see
DESKTOP_AUTO_SHOW_MEDIA=false
DESKTOP_HISTORY_MESSAGE_LIMIT=50
